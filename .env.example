# Copia este archivo como .env y completa tus valores. NO subas .env a GitHub.

# --- PostgreSQL ---
PG_USER=postgres
PG_PASSWORD=cambia_esta_clave
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=colegio
PG_TABLE=nomina_matricula
IF_EXISTS=append

# --- Origen de datos ---
INPUT_PATH=datos/ejemplo_nomina.xlsx
SHEET_NAME=Nomina Matricula

# --- Envío de correo (contraseña de aplicación de Gmail, no la normal) ---
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_TO=destino@gmail.com
